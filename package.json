    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "openai": "^7.10.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "robots-parser": "^3.0.1",
