# Copy to .env.local. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Must support Responses structured outputs; choose a model available to your account.
OPENAI_MODEL=gpt-6-astra
# Optional per-stage overrides. Blank values use OPENAI_MODEL above.
# FAST: extraction/grouping (example: gpt-5.6-luna).
OPENAI_MODEL_FAST=
# QUALITY: initial generation and one selective repair (example: gpt-5.6-luna).
OPENAI_MODEL_QUALITY=
# Optional one-item escalation after failed QUALITY repair (example: gpt-5.6-terra).
# Blank disables escalation; unsafe items are omitted.
OPENAI_MODEL_FALLBACK=
# Explicit localhost-only synthetic demo. Set false for production.
LOCAL_STAGING_MODE=false
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
APP_ORIGIN=http://localhost:3000
FREE_REVIEW_LIMIT=500
MAX_REVIEWS_PER_PROJECT=200
FREE_FOLLOWUP_LIMIT=30
# Comma-separated hostnames. Unknown domains default to manual-import-only.
URL_SUPPORTED_DOMAINS=
URL_DISABLED_DOMAINS=
